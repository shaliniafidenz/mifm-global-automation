# ─── Login Credentials ───────────────────────────────────────────────────────
LOGIN_VALID_USERNAME=your_email@example.com
LOGIN_VALID_PASSWORD=YourPassword

LOGIN_INVALID_USERNAME=wrong@example.com
LOGIN_INVALID_PASSWORD=WrongPassword

# ─── CWO Creation Data ───────────────────────────────────────────────────────
CWO_BUILDING=10 MBC
CWO_LOCATION=10 MBC L5
CWO_PROBLEM_TYPE=Aircon is not cold

# ─── CWO Reset Data ──────────────────────────────────────────────────────────
CWO_RESET_BUILDING=CW
CWO_RESET_LOCATION=CW
CWO_RESET_PROBLEM_TYPE=Audio Visual
CWO_RESET_DESCRIPTION=This is a description for resetting CWO creation

# ─── Device Configuration ────────────────────────────────────────────────────
DEVICE_NAME=your_device_id
PLATFORM_VERSION=13
APP_PACKAGE=com.certisgroup.mifmv2
APP_ACTIVITY=com.certisgroup.mifmv2.MainActivity
