  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wdio": "wdio run ./wdio.conf.js",
    "clean-allure": "rimraf reports/allure-results reports/allure-report reports/.allure",
    "allure-generate": "allure generate reports/allure-results --output reports/allure-report --clean",
    "allure-open": "allure open reports/allure-report",
    "allure": "npm run allure-generate && npm run allure-open",
    "wdio-with-report": "npm run clean-allure && wdio run ./wdio.conf.js && npm run allure",
    "ui:web": "node scripts/ui-server.js",
    "report:html": "node scripts/open-report.js"
  },
